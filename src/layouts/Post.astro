---
import Base from './Base.astro';
import Seal from '../components/Seal.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import Giscus from '../components/Giscus.astro';
import { site } from '../config';
import { formatDateCN, ganzhiYear, readingTime } from '../utils/date';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
}
const { post, prev, next } = Astro.props;
const { title, description, date, tags } = post.data;
const minutes = readingTime(post.body ?? '');
---

<Base title={`${title} · ${site.name}`} description={description} image={post.data.cover}>
  <div id="progress" aria-hidden="true"></div>
  <article class="container">
    <header class="post-hero">
      <a class="post-back" href="/blog/">← 全部文章</a>
      <p class="kicker">文章 · {ganzhiYear(date.getFullYear())}年</p>
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDateCN(date)}</time>
        <span class="sep">·</span>
        <span>阅读约 {minutes} 分钟</span>
        {tags.length > 0 && (
          <>
            <span class="sep">·</span>
            <div class="tags">
              {tags.map((t) => (
                <a class="chip" href={`/search/?tag=${encodeURIComponent(t)}`}>{t}</a>
              ))}
            </div>
          </>
        )}
      </div>
      {post.data.cover && (
        <img
          class="post-cover"
          src={post.data.cover}
          alt={post.data.coverAlt ?? title}
          loading="lazy"
        />
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <div class="post-sign">
      <span>—— {site.author}，{formatDateCN(date)}</span>
      <Seal text="静观" size={38} />
    </div>

    <div class="subscribe-box">
      <h2>喜欢这篇？订阅我的分享</h2>
      <p class="sub">{site.subscribe.sub} 现在订阅，{site.subscribe.resourceTitle}会随欢迎邮件自动送到你的邮箱。</p>
      <SubscribeForm />
    </div>

    <nav class="post-nav" aria-label="文章导航">
      {prev ? (
        <a href={`/blog/${prev.slug}/`}>
          <span class="dir">← 较新一篇</span>
          {prev.data.title}
        </a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a class="next" href={`/blog/${next.slug}/`}>
          <span class="dir">较旧一篇 →</span>
          {next.data.title}
        </a>
      ) : (
        <span></span>
      )}
    </nav>

    <Giscus />
  </article>

  <script>
    // 阅读进度
    const bar = document.getElementById('progress');
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      if (bar) bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
    };
    document.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Base>
