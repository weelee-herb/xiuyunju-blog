---
// 朱砂印章：text 一到两个字，白文竖排
interface Props {
  text?: string;
  size?: number;
  class?: string;
}
const { text = '云', size = 56, class: className = '' } = Astro.props;
const chars = text.split('');
---
<span class:list={['seal', className]} style={`--seal-size:${size}px`} aria-hidden="true">
  <span class="chars">
    {chars.map((c) => <span>{c}</span>)}
  </span>
</span>
