---
import { site } from '../config';
import Seal from './Seal.astro';
import { ganzhiYear } from '../utils/date';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <Seal text="静观" size={44} />
    <div class="f-name">{site.name}</div>
    <div class="f-tag">{site.tagline}</div>
    <nav aria-label="页脚导航">
      <a href="/">首页</a>
      <a href="/blog/">文章</a>
      <a href="/about/">关于</a>
      <a href="/subscribe/">订阅</a>
      <a href="/rss.xml">RSS</a>
    </nav>
    <nav aria-label="社交链接">
      {site.social.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
      ))}
    </nav>
    <div class="f-copy">
      © {year} {site.name} · 岁在{ganzhiYear(year)} · Powered by <span class="latin">Astro</span>
    </div>
  </div>
</footer>
