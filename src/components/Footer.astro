---
import { site } from '../config';
import Seal from './Seal.astro';
import { ganzhiYear } from '../utils/date';

const year = new Date().getFullYear();
const days = Math.max(1, Math.floor((Date.now() - new Date(site.siteSince || year + '-01-01').getTime()) / 86400000));
---

<footer class="site-footer">
  <div class="container">
    <Seal text="静观" size={44} />
    <div class="f-name">{site.name}</div>
    <div class="f-tag">{site.tagline}</div>
    <nav aria-label="页脚导航">
      <a href="/">首页</a>
      <a href="/blog/">文章</a>
      <a href="/featured/">撷英</a>
      <a href="/projects/">作品直达</a>
      <a href="https://herb-quiz.cc.cd/" target="_blank" rel="noopener noreferrer" title="中药题库 · 邀请码 692626">题库</a>
      <a href="/about/">关于</a>
      <a href="/links/">友链</a>
      <a href="/feedback/">建议</a>
      <a href="/subscribe/">订阅</a>
      <a href="/privacy/">隐私</a>
      <a href="/rss.xml">RSS</a>
    </nav>
    <nav aria-label="社交链接">
      {site.social.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
      ))}
    </nav>
    <div class="f-copy">
      © {year} {site.name} · 岁在{ganzhiYear(year)} · 已运行 {days} 天 · Powered by <span class="latin">Astro</span>
    </div>
  </div>
</footer>
