---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import { site } from '../config';

const projects = site.projects;
---

<Base title={`作品直达 · ${site.name}`} description="云岫居作品与项目直达清单">
  <main class="container">
    <header class="page-hero">
      <p class="kicker">作品 · Projects</p>
      <h1 class="page-title">作品直达</h1>
      <p class="page-sub">每个作品都有独立入口，新增作品也会自动出现在这里。</p>
    </header>

    <div class="projects-grid">
      {projects.map((p) => (
        <article class="project-card">
          <a
            class="project-main"
            href={p.href}
            target={p.external ? '_blank' : undefined}
            rel={p.external ? 'noopener noreferrer' : undefined}
          >
            <Seal text={p.icon} size={44} />
            <div class="info">
              <div class="t">{p.name}</div>
              <div class="full">{p.fullName}</div>
              <div class="d">{p.desc}</div>
              <div class="note">{p.note}</div>
            </div>
          </a>
          {p.download && (
            <a class="dl" href={p.download} download rel="noopener">
              ⬇️ 下载离线分享包
            </a>
          )}
        </article>
      ))}
    </div>

    <p class="tiny">短链约定：<code>/go/herb-quiz</code>、<code>/go/herb-game</code>、<code>/go/game-download</code>。</p>
  </main>
</Base>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 30px;
  }
  .project-card {
    background: #fffdf6;
    border: 1px solid #e5dcc3;
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(46, 70, 60, 0.12);
  }
  .project-main {
    display: flex;
    gap: 14px;
    text-decoration: none;
    color: inherit;
  }
  .info {
    min-width: 0;
  }
  .t {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1e4234;
  }
  .full {
    color: #6c786f;
    font-size: 0.88rem;
    margin: 2px 0 6px;
  }
  .d {
    color: #4a5a52;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .note {
    margin-top: 8px;
    color: #8a6046;
    font-size: 0.86rem;
  }
  .dl {
    align-self: flex-start;
    background: #1e4234;
    color: #f6f1e5;
    border-radius: 999px;
    padding: 9px 18px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .tiny {
    margin-top: 30px;
    color: #8a8070;
    font-size: 0.83rem;
  }
</style>
