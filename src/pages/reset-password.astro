---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---

<Base title={`重置密码 · ${site.name}`} description="找回云岫居评论账号的密码">
  <meta name="robots" content="noindex,nofollow" slot="head" />
  <main class="page">
    <h1>找回密码</h1>
    <p class="page-sub">
      输入注册时使用的邮箱，我们会发一封重置邮件；或者直接用邮件里的链接设置新密码。
    </p>

    <div class="reset-card">
      <form id="forgot-form" hidden>
        <label for="reset-email">注册邮箱</label>
        <input id="reset-email" type="email" autocomplete="email" placeholder="you@example.com" required />
        <button type="submit" class="btn btn-primary">发送重置邮件</button>
      </form>

      <form id="reset-form" hidden>
        <p class="reset-tip">设置一个新密码，至少 6 位。</p>
        <label for="reset-password">新密码</label>
        <input id="reset-password" type="password" autocomplete="new-password" minlength="6" placeholder="至少 6 位" required />
        <label for="reset-confirm">再输一次</label>
        <input id="reset-confirm" type="password" autocomplete="new-password" minlength="6" placeholder="确认新密码" required />
        <button type="submit" class="btn btn-primary">重置密码</button>
      </form>

      <p id="reset-status" class="reset-status" role="status" aria-live="polite"></p>
      <p class="reset-back"><a href="/">返回首页</a> · <a href="/subscribe/">返回到评论区</a></p>
    </div>
  </main>

  <style>
    .page { max-width: 620px; margin: 0 auto; padding: 64px 20px 80px; }
    .page-sub { color: var(--ink-2); line-height: 1.9; }
    .reset-card {
      margin-top: 26px;
      padding: 24px;
      border: 1px solid var(--hairline);
      border-radius: 3px;
      background: color-mix(in srgb, var(--paper-2) 30%, transparent);
    }
    .reset-card form { display: grid; gap: 10px; }
    .reset-card form[hidden] { display: none; }
    .reset-card label { color: var(--ink-3); font-size: 0.78rem; letter-spacing: 0.08em; }
    .reset-card input {
      width: 100%;
      border: 1px solid var(--hairline-strong);
      border-radius: 2px;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: 0.9rem;
      padding: 9px 12px;
      outline: none;
    }
    .reset-card input:focus { border-color: var(--celadon-deep); }
    .reset-card button { justify-self: start; }
    .reset-tip { color: var(--ink-2); font-size: 0.82rem; }
    .reset-status { min-height: 1.2em; color: var(--ink-3); font-size: 0.78rem; line-height: 1.8; }
    .reset-status.ok { color: var(--celadon-deep); }
    .reset-status.err { color: var(--cinnabar); }
    .reset-back { margin-top: 18px; color: var(--ink-3); font-size: 0.76rem; }
    .reset-back a { color: var(--celadon-deep); }
  </style>

  <script>
    const params = new URLSearchParams(location.search);
    const token = params.get('token') || '';
    const forgotForm = document.getElementById('forgot-form');
    const resetForm = document.getElementById('reset-form');
    const status = document.getElementById('reset-status');

    const show = (message, kind = '') => {
      if (!status) return;
      status.textContent = message;
      status.className = 'reset-status ' + (kind ? kind : '');
    };

    if (token) {
      if (resetForm) resetForm.hidden = false;
    } else if (forgotForm) {
      forgotForm.hidden = false;
    }

    forgotForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = document.getElementById('reset-email') as HTMLInputElement;
      if (!input || !input.value.trim()) {
        show('请先输入邮箱', 'err');
        return;
      }
      show('请稍候…');
      try {
        const response = await fetch('/waline/auth/forgot', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: input.value.trim() }),
        });
        const data = await response.json().catch(() => ({}));
        if (response.ok && data.ok) {
          show(data.message || '重置邮件已发送，请查收', 'ok');
          input.value = '';
        } else {
          show(data.message || '发送失败，请稍后再试', 'err');
        }
      } catch {
        show('网络错误，请稍后再试', 'err');
      }
    });

    resetForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const password = document.getElementById('reset-password') as HTMLInputElement;
      const confirm = document.getElementById('reset-confirm') as HTMLInputElement;
      if (!password || !confirm) return;
      if (password.value.length < 6) {
        show('密码至少需要 6 位', 'err');
        return;
      }
      if (password.value !== confirm.value) {
        show('两次输入的密码不一致', 'err');
        return;
      }
      show('请稍候…');
      try {
        const response = await fetch('/waline/auth/reset', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, password: password.value }),
        });
        const data = await response.json().catch(() => ({}));
        if (response.ok && data.ok) {
          show(data.message || '密码已重置，请返回登录', 'ok');
          password.value = '';
          confirm.value = '';
        } else {
          show(data.message || '重置失败，请重新申请', 'err');
        }
      } catch {
        show('网络错误，请稍后再试', 'err');
      }
    });
  </script>
</Base>
