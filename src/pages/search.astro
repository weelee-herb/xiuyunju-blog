---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
---

<Base title={`搜索 · ${site.name}`} description="站内搜索">
  <div class="container">
    <header class="page-hero">
      <p class="kicker">搜索 · Search</p>
      <h1 class="page-title">搜索</h1>
      <p class="page-sub">输入关键词，在全部 {posts.length} 篇文章里查找。</p>
    </header>

    <input
      type="search"
      id="search-input"
      class="search-input"
      placeholder="搜索标题、正文、标签……"
      autocomplete="off"
      aria-label="搜索"
    />

    <div class="tag-filter" role="group" aria-label="按标签筛选">
      <button class="chip chip-active" data-tag="">全部</button>
      {tags.map((t) => <button class="chip" data-tag={t}>{t}</button>)}
    </div>

    <div id="search-results" class="search-results" aria-live="polite">
      <p class="search-hint">输入关键词开始搜索。</p>
    </div>
  </div>
</Base>

<script>
  type Post = { slug: string; title: string; description: string; date: string; tags: string[]; body: string };

  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.tag-filter .chip'));

  let all: Post[] = [];
  let activeTag = '';

  function fmt(iso: string) {
    const d = new Date(iso);
    return `${d.getFullYear()}年${String(d.getMonth() + 1).padStart(2, '0')}月${String(d.getDate()).padStart(2, '0')}日`;
  }

  function el(tag: string, cls: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  // 用 DOM API 构建（textContent 赋值，天然防 XSS）
  function render(list: Post[]) {
    results.innerHTML = '';
    if (!list.length) {
      results.appendChild(el('p', 'search-hint', '没有找到相关文章，换个关键词试试。'));
      return;
    }
    for (const p of list) {
      const a = el('a', 'search-item') as HTMLAnchorElement;
      a.href = '/blog/' + p.slug + '/';
      const meta = el('div', 'meta');
      meta.appendChild(el('span', '', fmt(p.date)));
      p.tags.slice(0, 3).forEach((t) => meta.appendChild(el('span', 'chip', t)));
      a.appendChild(meta);
      a.appendChild(el('h3', '', p.title));
      a.appendChild(el('p', '', p.description));
      results.appendChild(a);
    }
  }

  function apply() {
    const q = input.value.trim().toLowerCase();
    const list = all.filter((p) => {
      const inTag = !activeTag || p.tags.includes(activeTag);
      if (!inTag) return false;
      if (!q) return true;
      return (p.title + p.description + p.tags.join(' ') + p.body).toLowerCase().includes(q);
    });
    render(list);
  }

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      activeTag = c.dataset.tag || '';
      chips.forEach((x) => {
        const on = x.dataset.tag === activeTag;
        x.classList.toggle('chip-active', on);
        x.setAttribute('aria-pressed', String(on));
      });
      apply();
    }),
  );

  input.addEventListener('input', apply);

  fetch('/posts.json')
    .then((r) => r.json())
    .then((d: Post[]) => {
      all = d;
      const params = new URLSearchParams(location.search);
      const q = params.get('q');
      const t = params.get('tag');
      if (q) input.value = q;
      if (t && chips.some((c) => c.dataset.tag === t)) {
        activeTag = t;
        chips.forEach((x) => {
          const on = x.dataset.tag === activeTag;
          x.classList.toggle('chip-active', on);
          x.setAttribute('aria-pressed', String(on));
        });
      }
      apply();
    });
</script>
