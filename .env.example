# 站点域名（部署平台可自动注入）
SITE_URL=
# ── 订阅表单「自动回信」配置 ─────────────────────────────
# 方式一（推荐，Node 部署）：用 Resend 发自动回信
# 1) 去 https://resend.com 注册（免费额度足够个人博客用）
# 2) 在 Resend 里验证你的发件域名，拿到 API Key
# 3) 把下面的内容复制到同目录的 .env 文件并填好

RESEND_API_KEY=

# 发件人：必须是你在 Resend 验证过的域名邮箱
EMAIL_FROM="云岫居 <share@example.com>"

# 退订链接签名（可选，未设置时回退使用 RESEND_API_KEY）
UNSUBSCRIBE_SECRET=

# 订阅欢迎邮件标题（可选，不填用默认）
EMAIL_SUBJECT="云岫居 · 欢迎订阅"

# 可选：有新订阅时，给站长自己也发一封通知
EMAIL_TO_OWNER=

# ── 方式二（纯静态部署，无需服务器）─────────────────────
# 到 https://web3forms.com 免费申请一个 Access Key 填到下面，
# 表单会自动改走 Web3Forms（自动回信模板在它后台配置）。
# 注意：设了这个以后，上面的 RESEND_API_KEY 会被忽略。
PUBLIC_WEB3FORMS_KEY=

# 欢迎分享《识药闯关》游戏下载链接（订阅自动回信会用；留空用占位链接）
GAME_DOWNLOAD_URL=
